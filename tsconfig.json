{
  "compilerOptions": {
    // === Language & Environment ===
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // === Module System ===
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    // === Emit ===
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "importHelpers": true,
    "stripInternal": true,

    // === Type Checking ===
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // === Modules ===
    "paths": {
      "@/*": ["./src/*"],
      "@/types": ["./src/declarations.ts"]
    },

    // === Performance ===
    "skipLibCheck": true,

    // === Output Formatting ===
    "noErrorTruncation": true,
    "preserveWatchOutput": true,
    "pretty": true
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/__mocks__/**",
    "examples/**/*",
    "docs/**/*",
    "*.config.js",
    "*.config.ts"
  ]
}
