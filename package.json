{
  "name": "@adoratorio/demetra",
  "version": "2.7.1",
  "description": "Internal use library for wordpress API request",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adoratorio/demetra.git"
  },
  "keywords": [
    "API",
    "Firebase",
    "Wordpress",
    "adoratorio"
  ],
  "author": "Adoratorio Studio <contact@adoratorio.com>",
  "contributors": [
    "Andrea Gottardi <andrea@adoratorio.com>",
    "Daniele Borra <daniele@adoratorio.com>",
    "Andrea Biason <biazo@adoratorio.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Adoratorio/demetra/issues"
  },
  "homepage": "https://github.com/Adoratorio/demetra#readme",
  "packageManager": "pnpm@11.12.0",
  "dependencies": {
    "js-md5": "^0.9.2",
    "lru-cache": "^11.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2"
  }
}
